{
  "name": "@ocw/local-runtime",
  "version": "0.0.0",
  "private": true,
  "description": "Local Runtime daemon: Device Link client, project registry, Claude Code adapter, git adapter",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "ocw-runtime": "./bin/ocw-runtime"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "start": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "fixtures:record": "tsx scripts/record-fixture.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.287",
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
