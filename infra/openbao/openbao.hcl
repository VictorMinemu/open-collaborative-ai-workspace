# OpenBao server for the `vault` profile (SELF-02, D-04, D-16). No secret in this file: the static seal key is read
# from a tmpfs copy of OCW_OPENBAO_SEAL_KEY_FILE (see compose.yaml), the root token is revoked by `ocw enable vault`.
#
# Integrated storage (raft, single node): OpenBao 2.x no longer ships the `file` backend ("unknown storage type file"
# on 2.7.1). The volume is mounted at /openbao/file, the directory the image creates for the openbao user.
storage "raft" {
  path    = "/openbao/file"
  node_id = "ocw-openbao"
}

# Plain HTTP: OpenBao is reachable only on the compose network (no published port).
listener "tcp" {
  address     = "0.0.0.0:8200"
  tls_disable = true
}

# Static auto-unseal: 32 random bytes generated by `ocw enable vault`. A restart unseals without a human. Losing the
# key file loses the data (the recovery key in secrets/openbao-init.json cannot unseal); back up secrets/ with .env.
seal "static" {
  current_key_id = "ocw-1"
  current_key    = "file:///run/openbao/seal.key"
}

api_addr      = "http://openbao:8200"
cluster_addr  = "http://openbao:8201"
disable_mlock = true
ui            = false
