<?xml version="1.0" encoding="UTF-8"?>
<!--
  LibreOffice finalized defaults of the bot sandbox `sbx` (phase 07.17.1.1.1, D-08, PD-11; ADR-0043), installed as
  /usr/lib/libreoffice/share/registry/ocw.xcd (root-owned, read-only for the bot). `oor:finalized` means no user
  profile can change these keys, including the one a bot's own `soffice` call creates under /workspace: macros never
  run (highest security level, execution disabled), untrusted referer links are blocked, and Writer and Calc never
  update links (1 = never) when a document is opened or converted.
-->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
  <dependency file="main"/>
  <oor:component-data oor:name="Common" oor:package="org.openoffice.Office">
    <node oor:name="Security">
      <node oor:name="Scripting">
        <prop oor:name="MacroSecurityLevel" oor:finalized="true"><value>3</value></prop>
        <prop oor:name="DisableMacrosExecution" oor:finalized="true"><value>true</value></prop>
        <prop oor:name="BlockUntrustedRefererLinks" oor:finalized="true"><value>true</value></prop>
      </node>
    </node>
  </oor:component-data>
  <oor:component-data oor:name="Writer" oor:package="org.openoffice.Office">
    <node oor:name="Content">
      <node oor:name="Update">
        <prop oor:name="Link" oor:finalized="true"><value>1</value></prop>
      </node>
    </node>
  </oor:component-data>
  <oor:component-data oor:name="Calc" oor:package="org.openoffice.Office">
    <node oor:name="Content">
      <node oor:name="Update">
        <prop oor:name="Link" oor:finalized="true"><value>1</value></prop>
      </node>
    </node>
  </oor:component-data>
</oor:data>
