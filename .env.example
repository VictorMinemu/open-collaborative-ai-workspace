# Open Collaborative AI Workspace — environment template.
# Run `pnpm setup:env` to generate a local .env with random secrets. Never commit .env.
# Every secret also accepts NAME_FILE=/path/to/file (Docker secrets).

# ---- PostgreSQL (superuser is used ONLY by the one-shot `migrate` service) ----
POSTGRES_PASSWORD=change-me
OCW_DB_MIGRATOR_PASSWORD=change-me
OCW_DB_APP_PASSWORD=change-me
OCW_DB_AUTH_PASSWORD=change-me

# ---- API secrets ----
# >= 32 chars; signs session cookies.
BETTER_AUTH_SECRET=change-me-to-at-least-32-random-characters
# One-time token to create the first organization + admin on /setup.
OCW_SETUP_TOKEN=change-me-setup-token
# 32 bytes (base64 or 64 hex chars); encrypts org secrets such as model provider API keys.
OCW_ENCRYPTION_KEY=change-me

# ---- Bots (OpenClaw cell ↔ Agent Channel API) ----
# Bearer token shared by the API and the openclaw container (>= 32 chars). Grants Agent Channel API scope only.
# Admins can also mint/rotate a token in Settings › Bots runtime.
OCW_CELL_TOKEN=change-me-cell-token-at-least-32-characters
# Set to `mock` to offer the deterministic fake model (fake/mock-1) to bots; E2E/CI only, never metered.
OCW_MODEL_PROVIDER=
# Fake model base URL as seen from the openclaw container (only used when OCW_MODEL_PROVIDER=mock).
OCW_MOCK_MODEL_BASE_URL=http://fake-model:18999/v1

# ---- Public URLs (as seen by the browser) ----
OCW_PUBLIC_WEB_URL=http://localhost:3000
OCW_PUBLIC_API_URL=http://localhost:4000
# Extra allowed origins, comma-separated (e.g. http://192.168.1.20:3000 for a LAN demo).
OCW_TRUSTED_ORIGINS=

# ---- E-mail (optional) ----
# Password reset e-mails are optional: without SMTP, admins issue single-use reset links from Settings › Members.
# smtp:// or smtps:// URL with credentials (a secret; OCW_SMTP_URL_FILE also works).
# OCW_SMTP_URL=smtps://user:password@smtp.example.com:465
# Sender shown on platform e-mails.
# OCW_MAIL_FROM=Open Collaborative AI Workspace <no-reply@example.com>

# ---- Host ports published by docker compose ----
OCW_POSTGRES_PORT=54329
OCW_REDIS_PORT=63799

# ---- Local development with `pnpm dev` (API on the host, Postgres/Redis from compose) ----
DATABASE_URL=postgres://ocw_app:${OCW_DB_APP_PASSWORD}@localhost:54329/ocw
AUTH_DATABASE_URL=postgres://ocw_auth:${OCW_DB_AUTH_PASSWORD}@localhost:54329/ocw
MIGRATOR_DATABASE_URL=postgres://ocw_migrator:${OCW_DB_MIGRATOR_PASSWORD}@localhost:54329/ocw
MIGRATE_SUPERUSER_URL=postgres://postgres:${POSTGRES_PASSWORD}@localhost:54329/ocw
REDIS_URL=redis://localhost:63799
