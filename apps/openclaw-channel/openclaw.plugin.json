{
  "id": "ocw",
  "name": "Open Collaborative AI Workspace",
  "description": "Agent Channel API bridge: OCW bots as OpenClaw agents (tool-gated).",
  "categories": ["channels"],
  "channels": ["ocw"],
  "contracts": {
    "tools": [
      "ocw_memory_save",
      "ocw_memory_list",
      "ocw_memory_read",
      "ocw_memory_write",
      "ocw_memory_propose",
      "ocw_agent_card",
      "ocw_board_card",
      "ocw_connector_list",
      "ocw_connector_call",
      "ocw_http_request",
      "ocw_work_zone_projects",
      "ocw_start_work_zone",
      "ocw_sandbox_exec",
      "ocw_sandbox_process",
      "ocw_sandbox_read",
      "ocw_sandbox_write",
      "ocw_sandbox_list",
      "ocw_sandbox_delete",
      "ocw_sandbox_share",
      "ocw_sandbox_import",
      "ocw_browser_open",
      "ocw_browser_snapshot",
      "ocw_browser_act",
      "ocw_browser_screenshot",
      "ocw_browser_wait",
      "ocw_browser_signin",
      "ocw_browser_close",
      "ocw_attachment_read",
      "ocw_automation_propose",
      "ocw_record_update",
      "ocw_consult_agent"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "ocw": {
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "apiUrl": { "type": "string", "format": "uri" },
          "tokenFile": { "type": "string" },
          "tokenEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" }
        }
      },
      "uiHints": {
        "tokenFile": { "label": "Cell token file", "sensitive": true }
      }
    }
  }
}
