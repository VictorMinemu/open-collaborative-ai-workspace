{
  "name": "@ocw/sandboxd",
  "version": "0.1.0",
  "private": true,
  "description": "Sandbox broker: the only holder of the Docker API; builds each bot's hardened sandbox from a fixed spec",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "node --watch-path=src --import tsx src/main.ts",
    "start": "node --import tsx src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node24 --legal-comments=none --outfile=dist/sandboxd.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. --project unit apps/sandboxd/src"
  },
  "dependencies": {
    "@ocw/contracts": "workspace:*",
    "@ocw/egress-policy": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@ocw/config": "workspace:*",
    "@types/node": "24.13.6",
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
  }
}
