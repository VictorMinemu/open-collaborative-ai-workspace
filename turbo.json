{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": [],
      "outputs": []
    },
    "//#typecheck:e2e": {
      "dependsOn": [],
      "inputs": [
        "e2e/**/*.ts",
        "e2e/tsconfig.json",
        "packages/config/*.json",
        "packages/contracts/src/**/*.ts"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
