{
  "name": "@ocw/desktop",
  "productName": "OCW",
  "version": "0.1.0",
  "private": true,
  "description": "OCW desktop shell: pairs this computer, supervises the Local Runtime daemon and opens the workspace",
  "license": "AGPL-3.0-only",
  "author": "Autofy Labs",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:daemon": "node scripts/build.mjs --daemon",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "icons": "node scripts/icons.mjs",
    "package:mac": "node scripts/build.mjs --daemon && electron-builder --mac dir dmg --arm64 --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:smoke": "node scripts/build.mjs && playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@ocw/config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "electron": "44.4.5",
    "electron-builder": "26.16.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.2",
    "zod": "4.6.5"
  }
}
