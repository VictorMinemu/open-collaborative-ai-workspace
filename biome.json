{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/.next-e2e",
      "!**/dist",
      "!**/.turbo",
      "!**/drizzle/meta",
      "!apps/local-runtime/src/codex/generated",
      "!apps/local-runtime/src/**/__fixtures__",
      "!**/next-env.d.ts",
      "!apps/web/public/emojibase",
      "!e2e/test-results",
      "!e2e/playwright-report",
      "!.planning",
      "!docs",
      "!.semgrep/tests"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "error", "noUndeclaredEnvVars": "off" },
      "style": { "noNonNullAssertion": "off" },
      "a11y": { "useSemanticElements": "off" },
      "correctness": { "noUnusedImports": "error" }
    }
  },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } }
}
