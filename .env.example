# Open Collaborative AI Workspace — environment template.
# Run `pnpm ocw setup` to generate a local .env with random secrets (`pnpm setup:env` is an alias). It prints which
# keys it wrote, never a value. Never commit .env.
# Every secret also accepts NAME_FILE=/path/to/file (Docker secrets, non-compose deployments).

# ---- PostgreSQL (superuser is used ONLY by the one-shot `migrate` service) ----
POSTGRES_PASSWORD=change-me
OCW_DB_MIGRATOR_PASSWORD=change-me
OCW_DB_APP_PASSWORD=change-me
OCW_DB_AUTH_PASSWORD=change-me

# ---- API secrets ----
# >= 32 chars; signs session cookies.
BETTER_AUTH_SECRET=change-me-to-at-least-32-random-characters
# One-time token to create the first organization + admin on /setup.
OCW_SETUP_TOKEN=change-me-setup-token
# 32 bytes (base64 or 64 hex chars); encrypts org secrets such as model provider API keys.
OCW_ENCRYPTION_KEY=change-me

# ---- Bots (OpenClaw cell ↔ Agent Channel API) ----
# Bearer token shared by the API and the openclaw container (>= 32 chars). Grants Agent Channel API scope only.
# Admins can also mint/rotate a token in Settings › Bots runtime.
OCW_CELL_TOKEN=change-me-cell-token-at-least-32-characters
# Set to `mock` to offer the deterministic fake model (fake/mock-1) to bots; E2E/CI only, never metered.
OCW_MODEL_PROVIDER=
# Fake model base URL as seen from the openclaw container (only used when OCW_MODEL_PROVIDER=mock).
OCW_MOCK_MODEL_BASE_URL=http://fake-model:18999/v1

# ---- Automations and job workers (Phase 07.6, ADR-0028) ----
# Schedules, webhooks, mailbox polls, watched-record checks and digests run as jobs in PostgreSQL (schema pgboss,
# installed by the migrate service). Empty = on. `off` makes an API replica answer requests only; keep at least one on.
# OCW_JOBS_WORKER=

# ---- Bot sandboxes and browser (optional `sandbox` compose profile, Phase 07.8) ----
# Off by default (D-12): nothing runs until an admin turns on Sandbox & Browser in Settings, and nothing can until the
# profile runs. To enable: COMPOSE_PROFILES=sandbox (add it to the list) and OCW_SANDBOX_URL=http://sandboxd:8090, then
# `docker compose up -d --build --wait`. sandboxd is the only service with the Docker socket, publishes no port and is
# reachable only by the API on the internal `sandbox-control` network.
# Bearer token shared by the API and sandboxd (>= 32 chars; `pnpm ocw setup` generates it, *_FILE works too).
OCW_SANDBOX_TOKEN=change-me-sandbox-token-at-least-32-characters
# The broker as the API sees it; empty = sandboxes off (Settings shows the service as down).
OCW_SANDBOX_URL=
# Isolation: auto (gVisor `runsc` when the daemon has it, else hardened runc), runsc (refuse without it) or runc.
# OCW_SANDBOX_RUNTIME=auto
# Label namespace of every sandbox container, network and volume (default: the compose project name; lower-case
# letters, digits and dashes, at most 48 characters).
# OCW_SANDBOX_NAMESPACE=
# Sweep interval of quota, idle stop and usage in ms (default 60000).
# OCW_SANDBOXD_SWEEP_MS=60000
# Registries of admin-approved sandbox packages (07.8-17) and the hosts a review or install may reach (comma list;
# empty = npm, PyPI, Debian and the ClawHub host). OCW_CLAWHUB_URL (Marketplace) is shared with sandboxd and must be
# the same value the API uses.
# OCW_SANDBOX_NPM_REGISTRY=https://registry.npmjs.org/
# OCW_SANDBOX_PYPI_INDEX=https://pypi.org/simple/
# OCW_SANDBOX_REGISTRIES=
# OCW_CLAWHUB_URL=https://clawhub.ai
# Compose sets these from OCW_IMAGE_TAG and the sandboxd image; only a deployment without compose sets them by hand.
# OCW_SANDBOX_SBX_IMAGE=ocw-sandbox-sbx:local
# OCW_SANDBOX_BRW_IMAGE=ocw-sandbox-brw:local
# OCW_SANDBOX_EGRESS_IMAGE=ocw-sandbox-egress:local
# OCW_SANDBOX_BRW_SECCOMP=/app/brw-seccomp.json

# ---- Public URLs (as seen by the browser) ----
OCW_PUBLIC_WEB_URL=http://localhost:3000
OCW_PUBLIC_API_URL=http://localhost:4000
# Extra allowed origins, comma-separated (e.g. http://192.168.1.20:3000 for a LAN demo).
OCW_TRUSTED_ORIGINS=

# ---- E-mail (optional) ----
# Password reset e-mails are optional: without SMTP, admins issue single-use reset links from Settings › Members.
# smtp:// or smtps:// URL with credentials (a secret; OCW_SMTP_URL_FILE also works).
# OCW_SMTP_URL=smtps://user:password@smtp.example.com:465
# Sender shown on platform e-mails.
# OCW_MAIL_FROM=Open Collaborative AI Workspace <no-reply@example.com>

# ---- Devices ----
# Accept the raw device token on the Device Link from desktop apps built before Phase 2 (each use is warned and
# audited). Set to false once every desktop app is rebuilt; removed in Phase 8 with the RFC 8628 device grant.
# OCW_ACCEPT_LEGACY_DEVICE_TOKEN=true

# ---- Host ports published by docker compose ----
OCW_POSTGRES_PORT=54329
OCW_REDIS_PORT=63799

# ---- Local development with `pnpm dev` (API on the host, Postgres/Redis from compose) ----
DATABASE_URL=postgres://ocw_app:${OCW_DB_APP_PASSWORD}@localhost:54329/ocw
AUTH_DATABASE_URL=postgres://ocw_auth:${OCW_DB_AUTH_PASSWORD}@localhost:54329/ocw
MIGRATOR_DATABASE_URL=postgres://ocw_migrator:${OCW_DB_MIGRATOR_PASSWORD}@localhost:54329/ocw
MIGRATE_SUPERUSER_URL=postgres://postgres:${POSTGRES_PASSWORD}@localhost:54329/ocw
REDIS_URL=redis://localhost:63799

# Object storage for chat attachments (Garage in compose, ADR-0015). `pnpm ocw setup` fills the three secrets;
# existing installs add them with `pnpm ocw setup --add-missing` (never rotates anything). The API reaches Garage on
# OCW_S3_ENDPOINT (compose overrides it with http://garage:3900) and signs browser URLs for OCW_S3_PUBLIC_URL.
# Leave the key id or secret empty to run without attachments.
GARAGE_RPC_SECRET=
OCW_S3_ACCESS_KEY_ID=
OCW_S3_SECRET_ACCESS_KEY=
OCW_S3_ENDPOINT=http://127.0.0.1:3900
OCW_S3_PUBLIC_URL=http://localhost:3900
OCW_S3_BUCKET=ocw-attachments
OCW_S3_REGION=garage
OCW_S3_PORT=3900
OCW_ATTACHMENT_MAX_BYTES=26214400

# ---- Release and optional profiles ----
# Commented = Compose's default. `pnpm ocw …` commands write these; edit by hand only if you know why.
# Compose project: its own containers, volumes and network (`ocw setup --project`; default: the directory name).
# COMPOSE_PROJECT_NAME=
# Optional profiles to start, comma-separated: proxy, observability, vault (`ocw enable <profile>`), sandbox (bot
# sandboxes; set OCW_SANDBOX_URL above with it).
# COMPOSE_PROFILES=
# Tag of the locally built images ocw-api, ocw-web, ocw-openclaw (`ocw setup --image-tag`; default: local).
# OCW_IMAGE_TAG=
# Host ports of the web and the API (default 3000 and 4000). `ocw setup --ports NN` puts every published port,
# these and the ones below, in the NN00-NN99 block and moves the public and local URLs with them.
# OCW_WEB_PORT=
# OCW_API_PORT=
# Host address the web and API ports bind to (default 0.0.0.0; `ocw enable proxy` sets 127.0.0.1).
# OCW_PUBLISH_ADDRESS=
# Trust X-Forwarded-* from one reverse-proxy hop (default false; `ocw enable proxy` sets 1).
# OCW_TRUST_PROXY=
# Site address Caddy serves and gets a certificate for, e.g. ocw.example.com (`ocw enable proxy --site-address`).
# OCW_SITE_ADDRESS=
# Host ports Caddy publishes (default 80 and 443; `ocw setup --ports NN`: NN80 and NN43).
# OCW_PROXY_HTTP_PORT=
# OCW_PROXY_HTTPS_PORT=
# OTLP endpoint for the API's traces, metrics and logs (`ocw enable observability`; empty = telemetry off).
# OCW_OTEL_ENDPOINT=
# Grafana host port (`ocw setup --ports NN`: NN05) and admin password (a secret; `ocw enable observability`).
# OCW_GRAFANA_PORT=
# OCW_GRAFANA_ADMIN_PASSWORD=
# OpenBao address and AppRole credentials for the API-only secrets (`ocw enable vault`; *_FILE works for secrets).
# OCW_OPENBAO_ADDR=
# OCW_OPENBAO_ROLE_ID=
# OCW_OPENBAO_SECRET_ID=
# OpenBao token auth instead of AppRole (a secret; OCW_OPENBAO_TOKEN_FILE works too).
# OCW_OPENBAO_TOKEN=
