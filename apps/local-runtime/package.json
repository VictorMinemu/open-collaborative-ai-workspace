{
  "name": "@ocw/local-runtime",
  "version": "0.3.2",
  "private": true,
  "description": "Local Runtime daemon: Device Link client, project registry, Claude Code adapter, git adapter",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "ocw-runtime": "./bin/ocw-runtime"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "start": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build:bundle": "node scripts/build-bundle.mjs",
    "fixtures:record": "tsx scripts/record-fixture.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.282",
    "@anthropic-ai/sdk": "0.128.0",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@ocw/contracts": "workspace:*",
    "tsx": "4.23.15",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@ocw/config": "workspace:*",
    "@types/node": "24.13.6",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2"
  }
}
