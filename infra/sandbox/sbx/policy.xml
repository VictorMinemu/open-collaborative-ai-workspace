<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policymap [
  <!ELEMENT policymap (policy)*>
  <!ATTLIST policymap xmlns CDATA #FIXED ''>
  <!ELEMENT policy EMPTY>
  <!ATTLIST policy xmlns CDATA #FIXED '' domain NMTOKEN #REQUIRED
    name NMTOKEN #IMPLIED pattern CDATA #IMPLIED rights NMTOKEN #IMPLIED
    stealth NMTOKEN #IMPLIED value CDATA #IMPLIED>
]>
<!--
  ImageMagick 6 policy of the bot sandbox `sbx` (phase 07.17.1.1.1, D-05, D-09, PD-12; ADR-0043). Replaces Debian's
  stock /etc/ImageMagick-6/policy.xml (same DOCTYPE header), which left the PS and PDF coders open.

  Deny everything, then allow reading and writing raster image formats only: no delegate (no external program), no
  filter, no `@file` path read, no coder outside the allow-list (PS, EPS, PDF, SVG, MSL, MVG, TEXT, LABEL, URL, HTTP,
  HTTPS, … are all refused with "not allowed by the security policy" before any I/O). ImageMagick applies the last
  matching policy, so the allow-list comes after the deny-all; glob patterns are case-sensitive in IM6, so the coder
  names are upper-case. The limits keep one conversion inside the sandbox's 256 MiB /tmp and its CPU share.
-->
<policymap>
  <policy domain="resource" name="temporary-path" value="/tmp"/>
  <policy domain="resource" name="memory" value="256MiB"/>
  <policy domain="resource" name="map" value="512MiB"/>
  <policy domain="resource" name="width" value="16KP"/>
  <policy domain="resource" name="height" value="16KP"/>
  <policy domain="resource" name="area" value="128MP"/>
  <policy domain="resource" name="disk" value="200MiB"/>
  <policy domain="resource" name="time" value="120"/>
  <policy domain="resource" name="thread" value="2"/>
  <policy domain="delegate" rights="none" pattern="*"/>
  <policy domain="filter" rights="none" pattern="*"/>
  <policy domain="path" rights="none" pattern="@*"/>
  <policy domain="coder" rights="none" pattern="*"/>
  <policy domain="coder" rights="read|write" pattern="{PNG,JPEG,JPG,GIF,WEBP,TIFF,TIF,BMP,HEIC,HEIF,AVIF,PNM,PBM,PGM,PPM,ICO}"/>
</policymap>
